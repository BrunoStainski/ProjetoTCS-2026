   "source": [
    "import os\n",
    "import re\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "caminho_projeto = Path.cwd()\n",
    "if caminho_projeto.name == \"Notebook_limpeza_dados\":\n",
    "    caminho_projeto = caminho_projeto.parent\n",
    "\n",
    "caminho_entrada = caminho_projeto / \"Datasets\" / \"Bombas-e-motobombas-centrifuga.csv\"\n",
    "caminho_saida = caminho_projeto / \"Datasets\" / \"bombas-e-motobombas_limpo.csv\""
   ]
  },
  {
   "cell_type": "markdown",
   "id": "650758e0",
   "metadata": {},
   "source": [
    "Notebook 2: Carga de Dados e Padronização de Cabeçalhos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "2c0be0a2",
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    df = pd.read_csv(caminho_entrada, encoding='utf-8')\n",
    "    if len(df.columns) == 1:\n",
    "        df = pd.read_csv(caminho_entrada, encoding='utf-8', sep=';')\n",
    "except:\n",
    "    df = pd.read_csv(caminho_entrada, encoding='latin1', sep=';')\n",
    "\n",
    "df.columns = df.columns.str.replace('ï»¿', '').str.strip()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1df2858a",
   "metadata": {},
   "source": [
    "Notebook 3: Limpeza de Identidade"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "9e237a2a",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = df.dropna(subset=['Marca', 'Modelo']).drop_duplicates()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fac8e4d8",
   "metadata": {},
   "source": [
    "Notebook 4: Unificação e Imputação de Potência "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "4bf97828",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['Potencia_Eletrica_W'] = df['Potência Elétrica Consumida 1Ø (W)'].fillna(\n",
    "    df['Potência Elétrica Consumida 3Ø (W)']\n",
    ")\n",
    "\n",
    "if 'Potência Motor (cv)' in df.columns:\n",
    "    df['Potencia_Eletrica_W'] = df['Potencia_Eletrica_W'].fillna(\n",
    "        pd.to_numeric(df['Potência Motor (cv)'], errors='coerce') * 735.5\n",
    "    )"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9d2af56a",
   "metadata": {},
   "source": [

   ],
   "source": [
    "colunas_imputar = [\n",
    "    'Capacidade_de_lavagem_kg',\n",
    "    'Consumo_de_energia_kWh_ciclo_água_fria',\n",
    "    'Consumo_de_água_l',\n",
    "    'Tempo_do_ciclo_min'\n",
    "]\n",
    "colunas_validas = [c for c in colunas_imputar if c in df.columns]\n",
    "\n",
    "# Imputação pela média agrupada em (Marca, Tipo_de_Lavadora)\n",
    "if 'Marca' in df.columns and 'Tipo_de_Lavadora' in df.columns:\n",
    "    df[colunas_validas] = (\n",
    "        df.groupby(['Marca', 'Tipo_de_Lavadora'])[colunas_validas]\n",
    "          .transform(lambda x: x.fillna(x.mean()))\n",
    "    )\n",
    "\n",
    "# Como a capacidade é essencial, removemos o que sobrou de nulo\n",
    "df = df.dropna(subset=['Capacidade_de_lavagem_kg'])\n",
    "\n",
    "print(f\"✓ Processo finalizado! Linhas prontas para uso: {len(df)}\")\n",
    "print(f\"Colunas finais: {list(df.columns)}\")\n",
    "\n",
    "caminho_saida = caminho_final.parent / \"maquinas-de-lavar_limpo.csv\"\n",
    "df.to_csv(caminho_saida, index=False)\n",
    "print(f\"✓ Dataset limpo salvo com sucesso em: {caminho_saida}\")"
   ]

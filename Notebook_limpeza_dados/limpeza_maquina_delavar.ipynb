   "source": [
    "Notebook 4: Conversão de Tipos e Filtragem de Outliers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "9dc0a943",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Tipos convertidos para numérico.\n",
      "Após filtro de tensão {127, 220}: 765 linhas\n",
      "Após filtro de Capacidade_de_lavagem_kg [1, 30]: 765 linhas\n",
      "Após filtro de Velocidade_de_centrifugação_rpm [0, 2000]: 763 linhas\n",
      "Após filtro de Consumo_de_água_l [0, 500]: 763 linhas\n",
      "Após filtro de Consumo_de_energia_kWh_ciclo_água_fria [0, 5]: 763 linhas\n",
      "✓ Filtros aplicados. Total removido: 20 | Linhas restantes: 763\n"
     ]
    }
   ],
   "source": [
    "# --- Conversão de tipos ---\n",
    "colunas_numericas = [\n",
    "    'Capacidade_de_lavagem_kg',\n",
    "    'Consumo_de_energia_kWh_ciclo_água_fria',\n",
    "    'Velocidade_de_centrifugação_rpm',\n",
    "    'Consumo_de_água_l',\n",
    "    'Tempo_do_ciclo_min'\n",
    "]\n",
    "\n",
    "for col in colunas_numericas:\n",
    "    if col in df.columns:\n",
    "        df[col] = pd.to_numeric(df[col], errors='coerce')\n",
    "\n",
    "# Tensão: extrair parte numérica\n",
    "if 'Tensão_V' in df.columns:\n",
    "    df['Tensão_V'] = df['Tensão_V'].astype(str).str.extract(r'(\\d+)')[0]\n",
    "    df['Tensão_V'] = pd.to_numeric(df['Tensão_V'], errors='coerce')\n",
    "\n",
    "print(\"✓ Tipos convertidos para numérico.\")\n",
    "\n",
    "# --- Filtros de inconsistência ---\n",
    "antes = len(df)\n",
    "\n",
    "if 'Tensão_V' in df.columns:\n",
    "    df = df[df['Tensão_V'].isin([127, 220])]\n",
    "    print(f\"Após filtro de tensão {{127, 220}}: {len(df)} linhas\")\n",
    "\n",
    "filtros = [\n",
    "    ('Capacidade_de_lavagem_kg', 1, 30),\n",
    "    ('Velocidade_de_centrifugação_rpm', 0, 2000),\n",
    "    ('Consumo_de_água_l', 0, 500),\n",
    "    ('Consumo_de_energia_kWh_ciclo_água_fria', 0, 5)\n",
    "]\n",
    "\n",
    "for col, minimo, maximo in filtros:\n",
    "    if col in df.columns:\n",
    "        mask = df[col].isna() | ((df[col] >= minimo) & (df[col] <= maximo))\n",
    "        df = df[mask]\n",
    "        print(f\"Após filtro de {col} [{minimo}, {maximo}]: {len(df)} linhas\")\n",
    "\n",
    "print(f\"✓ Filtros aplicados. Total removido: {antes - len(df)} | Linhas restantes: {len(df)}\")"
   ]
  },

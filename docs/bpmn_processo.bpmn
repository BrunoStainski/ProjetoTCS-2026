<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_iamp" targetNamespace="http://iamp.tcs2026/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="Colab_iamp">
    <bpmn:participant id="Pool_App" name="Usuário (App Flutter)" processRef="Proc_App" />
    <bpmn:participant id="Pool_Backend" name="Servidor Backend (FastAPI / Python, Docker)" processRef="Proc_Backend" />
    <bpmn:participant id="Pool_Offline" name="Preparação de dados e treino (offline, scripts)" processRef="Proc_Offline" />
    <bpmn:messageFlow id="MF_calc_req" name="POST /calcular" sourceRef="App_EnviarCalc" targetRef="Api_Inicio" />
    <bpmn:messageFlow id="MF_calc_resp" name="kWh, R$ e avisos" sourceRef="Api_Fim" targetRef="App_ResultadoCalc" />
    <bpmn:messageFlow id="MF_sug_req" name="POST /sugestoes" sourceRef="App_EnviarSug" targetRef="Sug_Inicio" />
    <bpmn:messageFlow id="MF_sug_resp" name="modelos mais econômicos" sourceRef="Sug_Fim" targetRef="App_SugRecebidas" />
    <bpmn:messageFlow id="MF_comp_req" name="POST /comparar" sourceRef="App_EnviarComp" targetRef="Comp_Inicio" />
    <bpmn:messageFlow id="MF_comp_resp" name="economia e payback" sourceRef="Comp_Fim" targetRef="App_Payback" />
    <bpmn:messageFlow id="MF_class_req" name="POST /classificar" sourceRef="App_EnviarClass" targetRef="Ml_Inicio" />
    <bpmn:messageFlow id="MF_class_resp" name="perfil e comparação" sourceRef="Ml_Fim" targetRef="App_Perfil" />
    <bpmn:messageFlow id="MF_eco_req" name="POST /eco-coach" sourceRef="App_EnviarEco" targetRef="Eco_Inicio" />
    <bpmn:messageFlow id="MF_eco_resp" name="plano com fontes [n]" sourceRef="Eco_Fim" targetRef="App_Plano" />
    <bpmn:textAnnotation id="Nota_Dicas">
      <bpmn:text>Eletroportátil (sem etiqueta do Inmetro): no lugar das sugestões de troca, dicas do Eco-Coach para o aparelho (POST /eco-coach/aparelho).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_Calc">
      <bpmn:text>Fora do catálogo: geladeira usa a etiqueta, a Portaria Inmetro 20/2006 ou o Random Forest; os outros, a mediana dos modelos equivalentes (com faixa). Valores sem impostos e bandeira.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_Economia">
      <bpmn:text>Equivalente = mesma categoria, medida parecida e mesmo tipo. Só consumo informado pelo Inmetro, economia mínima de 5% e descarte de consumo &lt; 40% da mediana (erro de dado). Payback = preço ÷ economia/mês.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_Ml">
      <bpmn:text>Não usa o banco nem grava nada. Treinado com casas sintéticas: a resposta avisa que o perfil é demonstrativo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_Coach">
      <bpmn:text>O Python calcula todos os números; o Gemini só escreve. Regras no prompt: não inventar números, toda dica com [n], ignorar instruções dentro das fontes. Se o modelo principal falha, tenta o reserva.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_Offline">
      <bpmn:text>Roda pelos scripts, não a cada requisição. A imagem da API leva só kmeans.pkl e refrigerador.pkl (guardam só números: a API não precisa de scikit-learn).</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Proc_App" isExecutable="false">
    <bpmn:startEvent id="App_Inicio" name="Quer saber quanto um aparelho gasta" />
    <bpmn:userTask id="App_Buscar" name="Buscar aparelho por marca/modelo" />
    <bpmn:exclusiveGateway id="App_NoCatalogo" name="Achou o modelo?" />
    <bpmn:userTask id="App_Uso" name="Informar uso (horas, ciclos ou velocidade)" />
    <bpmn:userTask id="App_Estimar" name="Informar o que sabe (etiqueta, volume, ano, potência)" />
    <bpmn:exclusiveGateway id="App_JuntaDados" />
    <bpmn:userTask id="App_Dist" name="Escolher distribuidora ou digitar tarifa da conta" />
    <bpmn:sendTask id="App_EnviarCalc" name="Enviar POST /calcular (ou /calcular/estimado)" />
    <bpmn:intermediateCatchEvent id="App_ResultadoCalc" name="Consumo e custo recebidos">
      <bpmn:messageEventDefinition id="MED_App_ResultadoCalc" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="App_VerResultado" name="Ver kWh e R$/mês e pôr na Minha casa" />
    <bpmn:exclusiveGateway id="App_QuerTroca" name="Ver modelos mais econômicos?" />
    <bpmn:sendTask id="App_EnviarSug" name="Enviar POST /sugestoes" />
    <bpmn:intermediateCatchEvent id="App_SugRecebidas" name="Sugestões recebidas">
      <bpmn:messageEventDefinition id="MED_App_SugRecebidas" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="App_Escolher" name="Escolher modelo e digitar o preço" />
    <bpmn:sendTask id="App_EnviarComp" name="Enviar POST /comparar" />
    <bpmn:intermediateCatchEvent id="App_Payback" name="Economia e payback recebidos">
      <bpmn:messageEventDefinition id="MED_App_Payback" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="App_Trocar" name="Ver payback e trocar na Minha casa" />
    <bpmn:exclusiveGateway id="App_JuntaTroca" />
    <bpmn:exclusiveGateway id="App_Mais" name="Mais aparelhos?" />
    <bpmn:userTask id="App_MinhaCasa" name="Abrir Minha casa e informar moradores" />
    <bpmn:sendTask id="App_EnviarClass" name="Enviar POST /classificar" />
    <bpmn:intermediateCatchEvent id="App_Perfil" name="Perfil recebido">
      <bpmn:messageEventDefinition id="MED_App_Perfil" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="App_EnviarEco" name="Enviar POST /eco-coach (consumos + trocas)" />
    <bpmn:intermediateCatchEvent id="App_Plano" name="Plano recebido">
      <bpmn:messageEventDefinition id="MED_App_Plano" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="App_LerPlano" name="Ler plano de economia com as fontes [n]" />
    <bpmn:endEvent id="App_Fim" name="Plano de economia pronto" />
    <bpmn:sequenceFlow id="F_a1" sourceRef="App_Inicio" targetRef="App_Buscar" />
    <bpmn:sequenceFlow id="F_a21" name="Sim" sourceRef="App_Mais" targetRef="App_Buscar" />
    <bpmn:sequenceFlow id="F_a2" sourceRef="App_Buscar" targetRef="App_NoCatalogo" />
    <bpmn:sequenceFlow id="F_a3" name="Sim" sourceRef="App_NoCatalogo" targetRef="App_Uso" />
    <bpmn:sequenceFlow id="F_a4" name="Não" sourceRef="App_NoCatalogo" targetRef="App_Estimar" />
    <bpmn:sequenceFlow id="F_a5" sourceRef="App_Uso" targetRef="App_JuntaDados" />
    <bpmn:sequenceFlow id="F_a6" sourceRef="App_Estimar" targetRef="App_JuntaDados" />
    <bpmn:sequenceFlow id="F_a7" sourceRef="App_JuntaDados" targetRef="App_Dist" />
    <bpmn:sequenceFlow id="F_a8" sourceRef="App_Dist" targetRef="App_EnviarCalc" />
    <bpmn:sequenceFlow id="F_a9" sourceRef="App_EnviarCalc" targetRef="App_ResultadoCalc" />
    <bpmn:sequenceFlow id="F_a10" sourceRef="App_ResultadoCalc" targetRef="App_VerResultado" />
    <bpmn:sequenceFlow id="F_a11" sourceRef="App_VerResultado" targetRef="App_QuerTroca" />
    <bpmn:sequenceFlow id="F_a12" name="Sim" sourceRef="App_QuerTroca" targetRef="App_EnviarSug" />
    <bpmn:sequenceFlow id="F_a19" name="Não" sourceRef="App_QuerTroca" targetRef="App_JuntaTroca" />
    <bpmn:sequenceFlow id="F_a13" sourceRef="App_EnviarSug" targetRef="App_SugRecebidas" />
    <bpmn:sequenceFlow id="F_a14" sourceRef="App_SugRecebidas" targetRef="App_Escolher" />
    <bpmn:sequenceFlow id="F_a15" sourceRef="App_Escolher" targetRef="App_EnviarComp" />
    <bpmn:sequenceFlow id="F_a16" sourceRef="App_EnviarComp" targetRef="App_Payback" />
    <bpmn:sequenceFlow id="F_a17" sourceRef="App_Payback" targetRef="App_Trocar" />
    <bpmn:sequenceFlow id="F_a18" sourceRef="App_Trocar" targetRef="App_JuntaTroca" />
    <bpmn:sequenceFlow id="F_a20" sourceRef="App_JuntaTroca" targetRef="App_Mais" />
    <bpmn:sequenceFlow id="F_a22" name="Não" sourceRef="App_Mais" targetRef="App_MinhaCasa" />
    <bpmn:sequenceFlow id="F_a23" sourceRef="App_MinhaCasa" targetRef="App_EnviarClass" />
    <bpmn:sequenceFlow id="F_a24" sourceRef="App_EnviarClass" targetRef="App_Perfil" />
    <bpmn:sequenceFlow id="F_a25" sourceRef="App_Perfil" targetRef="App_EnviarEco" />
    <bpmn:sequenceFlow id="F_a26" sourceRef="App_EnviarEco" targetRef="App_Plano" />
    <bpmn:sequenceFlow id="F_a27" sourceRef="App_Plano" targetRef="App_LerPlano" />
    <bpmn:sequenceFlow id="F_a28" sourceRef="App_LerPlano" targetRef="App_Fim" />
  </bpmn:process>
  <bpmn:process id="Proc_Backend" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Backend">
      <bpmn:lane id="Lane_Coach" name="Eco-Coach (RAG + Gemini)">
        <bpmn:flowNodeRef>Eco_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Rag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Llm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Erro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Fontes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Totais</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ml" name="Machine Learning (K-Means)">
        <bpmn:flowNodeRef>Ml_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ml_Indicadores</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ml_Kmeans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ml_Comparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ml_Fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Economia" name="Sugestão de troca e payback">
        <bpmn:flowNodeRef>Sug_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sug_Buscar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sug_Filtrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sug_Fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Comp_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Comp_Calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Comp_Fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Calc" name="Cálculo (API + PostgreSQL)">
        <bpmn:flowNodeRef>Api_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Erro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_NoCatalogo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Regras</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Estimar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_JuntaCalc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Tarifa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Api_Inicio" name="Pedido de cálculo recebido">
      <bpmn:messageEventDefinition id="MED_Api_Inicio" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Api_Validar" name="Validar aparelho, uso e tarifa" />
    <bpmn:exclusiveGateway id="Api_Valido" name="Dados válidos?" />
    <bpmn:endEvent id="Api_Erro" name="Erro 404 / 422" />
    <bpmn:exclusiveGateway id="Api_NoCatalogo" name="Aparelho do catálogo?" />
    <bpmn:serviceTask id="Api_Regras" name="Calcular kWh pelas regras do Inmetro (kWh/mês, kWh/ciclo ou W × horas)" />
    <bpmn:serviceTask id="Api_Estimar" name="Estimar kWh fora do catálogo (com faixa)">
      <bpmn:property id="Prop_Estimar" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Estimar">
        <bpmn:sourceRef>DOR_Refri</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Estimar</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Api_JuntaCalc" />
    <bpmn:serviceTask id="Api_Tarifa" name="Aplicar tarifa B1 da ANEEL ou a da conta (R$/mês)">
      <bpmn:property id="Prop_Tarifa" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Tarifa">
        <bpmn:sourceRef>DS_Postgres</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Tarifa</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Api_Registrar" name="Registrar consulta (sem dados pessoais)">
      <bpmn:dataOutputAssociation id="DOA_Registrar">
        <bpmn:targetRef>DS_Postgres</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Api_Fim" name="Resultado enviado">
      <bpmn:messageEventDefinition id="MED_Api_Fim" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_Postgres" name="PostgreSQL (aparelhos, tarifas, consultas)" />
    <bpmn:dataObjectReference id="DOR_Refri" name="refrigerador.pkl" dataObjectRef="DO_Refri" />
    <bpmn:dataObject id="DO_Refri" />
    <bpmn:startEvent id="Sug_Inicio" name="POST /sugestoes recebido">
      <bpmn:messageEventDefinition id="MED_Sug_Inicio" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Sug_Buscar" name="Buscar equivalentes (mesma categoria, medida e tipo)" />
    <bpmn:serviceTask id="Sug_Filtrar" name="Filtrar e ordenar pela economia (mesmo uso e tarifa)" />
    <bpmn:endEvent id="Sug_Fim" name="Sugestões enviadas">
      <bpmn:messageEventDefinition id="MED_Sug_Fim" />
    </bpmn:endEvent>
    <bpmn:startEvent id="Comp_Inicio" name="POST /comparar recebido">
      <bpmn:messageEventDefinition id="MED_Comp_Inicio" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Comp_Calcular" name="Calcular economia/mês e payback (Python)" />
    <bpmn:endEvent id="Comp_Fim" name="Comparação enviada">
      <bpmn:messageEventDefinition id="MED_Comp_Fim" />
    </bpmn:endEvent>
    <bpmn:startEvent id="Ml_Inicio" name="POST /classificar recebido">
      <bpmn:messageEventDefinition id="MED_Ml_Inicio" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Ml_Indicadores" name="Calcular kWh por morador e frações (chuveiro, ar, geladeira)" />
    <bpmn:serviceTask id="Ml_Kmeans" name="Classificar perfil (Consciente / Moderado / Ineficiente)">
      <bpmn:property id="Prop_Kmeans" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Kmeans">
        <bpmn:sourceRef>DOR_Kmeans</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Kmeans</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Ml_Comparar" name="Comparar com a mediana das casas sintéticas" />
    <bpmn:endEvent id="Ml_Fim" name="Perfil enviado">
      <bpmn:messageEventDefinition id="MED_Ml_Fim" />
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DOR_Kmeans" name="kmeans.pkl" dataObjectRef="DO_Kmeans" />
    <bpmn:dataObject id="DO_Kmeans" />
    <bpmn:startEvent id="Eco_Inicio" name="POST /eco-coach recebido">
      <bpmn:messageEventDefinition id="MED_Eco_Inicio" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Eco_Rag" name="Buscar trechos parecidos (embedding do Gemini + pgvector)">
      <bpmn:property id="Prop_Rag" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Rag">
        <bpmn:sourceRef>DS_Vetorial</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Rag</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Eco_Llm" name="Escrever plano com citações [n] (Gemini)" />
    <bpmn:exclusiveGateway id="Eco_Ok" name="Gemini respondeu?" />
    <bpmn:endEvent id="Eco_Erro" name="Erro 503" />
    <bpmn:serviceTask id="Eco_Fontes" name="Manter só as fontes citadas" />
    <bpmn:endEvent id="Eco_Fim" name="Plano enviado">
      <bpmn:messageEventDefinition id="MED_Eco_Fim" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_Vetorial" name="trechos_rag (pgvector): Inmetro + Cemig" />
    <bpmn:serviceTask id="Eco_Totais" name="Calcular perfil, totais e maiores consumos (Python)" />
    <bpmn:sequenceFlow id="F_b1" sourceRef="Api_Inicio" targetRef="Api_Validar" />
    <bpmn:sequenceFlow id="F_b2" sourceRef="Api_Validar" targetRef="Api_Valido" />
    <bpmn:sequenceFlow id="F_b3" name="Não" sourceRef="Api_Valido" targetRef="Api_Erro" />
    <bpmn:sequenceFlow id="F_b4" name="Sim" sourceRef="Api_Valido" targetRef="Api_NoCatalogo" />
    <bpmn:sequenceFlow id="F_b5" name="Sim" sourceRef="Api_NoCatalogo" targetRef="Api_Regras" />
    <bpmn:sequenceFlow id="F_b6" name="Não" sourceRef="Api_NoCatalogo" targetRef="Api_Estimar" />
    <bpmn:sequenceFlow id="F_b7" sourceRef="Api_Regras" targetRef="Api_JuntaCalc" />
    <bpmn:sequenceFlow id="F_b8" sourceRef="Api_Estimar" targetRef="Api_JuntaCalc" />
    <bpmn:sequenceFlow id="F_b9" sourceRef="Api_JuntaCalc" targetRef="Api_Tarifa" />
    <bpmn:sequenceFlow id="F_b10" sourceRef="Api_Tarifa" targetRef="Api_Registrar" />
    <bpmn:sequenceFlow id="F_b11" sourceRef="Api_Registrar" targetRef="Api_Fim" />
    <bpmn:sequenceFlow id="F_e1" sourceRef="Sug_Inicio" targetRef="Sug_Buscar" />
    <bpmn:sequenceFlow id="F_e2" sourceRef="Sug_Buscar" targetRef="Sug_Filtrar" />
    <bpmn:sequenceFlow id="F_e3" sourceRef="Sug_Filtrar" targetRef="Sug_Fim" />
    <bpmn:sequenceFlow id="F_e4" sourceRef="Comp_Inicio" targetRef="Comp_Calcular" />
    <bpmn:sequenceFlow id="F_e5" sourceRef="Comp_Calcular" targetRef="Comp_Fim" />
    <bpmn:sequenceFlow id="F_m1" sourceRef="Ml_Inicio" targetRef="Ml_Indicadores" />
    <bpmn:sequenceFlow id="F_m2" sourceRef="Ml_Indicadores" targetRef="Ml_Kmeans" />
    <bpmn:sequenceFlow id="F_m3" sourceRef="Ml_Kmeans" targetRef="Ml_Comparar" />
    <bpmn:sequenceFlow id="F_m4" sourceRef="Ml_Comparar" targetRef="Ml_Fim" />
    <bpmn:sequenceFlow id="F_k1" sourceRef="Eco_Inicio" targetRef="Eco_Totais" />
    <bpmn:sequenceFlow id="F_k2" sourceRef="Eco_Totais" targetRef="Eco_Rag" />
    <bpmn:sequenceFlow id="F_k3" sourceRef="Eco_Rag" targetRef="Eco_Llm" />
    <bpmn:sequenceFlow id="F_k4" sourceRef="Eco_Llm" targetRef="Eco_Ok" />
    <bpmn:sequenceFlow id="F_k5" name="Sim" sourceRef="Eco_Ok" targetRef="Eco_Fontes" />
    <bpmn:sequenceFlow id="F_k6" name="Não" sourceRef="Eco_Ok" targetRef="Eco_Erro" />
    <bpmn:sequenceFlow id="F_k7" sourceRef="Eco_Fontes" targetRef="Eco_Fim" />
  </bpmn:process>
  <bpmn:process id="Proc_Offline" isExecutable="false">
    <bpmn:startEvent id="Off_Inicio" name="Novos dados Inmetro / ANEEL" />
    <bpmn:serviceTask id="Off_Limpar" name="Limpar e tratar nulos (tratar_dados_*.py, Pandas)" />
    <bpmn:serviceTask id="Off_Carregar" name="Carregar no PostgreSQL (criar_banco.py)" />
    <bpmn:parallelGateway id="Off_Divide" />
    <bpmn:serviceTask id="Off_Seed" name="Gerar 3.000 casas por regras (seed)" />
    <bpmn:serviceTask id="Off_Ctgan" name="Treinar CTGAN e gerar 5.000 casas sintéticas" />
    <bpmn:serviceTask id="Off_Kmeans" name="Treinar K-Means (kmeans.pkl)" />
    <bpmn:serviceTask id="Off_Rf" name="Treinar Random Forest de geladeiras (refrigerador.pkl)" />
    <bpmn:serviceTask id="Off_Embed" name="Gerar embeddings dos documentos (Gemini)" />
    <bpmn:serviceTask id="Off_Pgvector" name="Gravar trechos no pgvector (carregar_rag.py)" />
    <bpmn:serviceTask id="Off_Eda" name="Gerar gráficos da EDA (notebook)" />
    <bpmn:parallelGateway id="Off_Junta" />
    <bpmn:endEvent id="Off_Fim" name="Dados e modelos atualizados" />
    <bpmn:sequenceFlow id="F_c1" sourceRef="Off_Inicio" targetRef="Off_Limpar" />
    <bpmn:sequenceFlow id="F_c2" sourceRef="Off_Limpar" targetRef="Off_Carregar" />
    <bpmn:sequenceFlow id="F_c3" sourceRef="Off_Carregar" targetRef="Off_Divide" />
    <bpmn:sequenceFlow id="F_c4" sourceRef="Off_Divide" targetRef="Off_Seed" />

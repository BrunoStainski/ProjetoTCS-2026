<?xml version="1.0" encoding="UTF-8"?>
<!--
  BPMN do iamp (versao alinhada a implementacao de 2026-11).
  Abrir/editar em https://demo.bpmn.io ou no Camunda Modeler e exportar o PNG (docs/bpmn_processo.png).
  Fluxo atual da API: POST /calcular (um por aparelho) + POST /classificar.
  O CTGAN e o K-Means sao treinados OFFLINE (pool de baixo); na requisicao so se aplica o kmeans.pkl.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_iamp" targetNamespace="http://iamp.tcs2026/bpmn">

  <bpmn:collaboration id="Colab_iamp">
    <bpmn:participant id="Pool_App" name="Usuário (App Flutter)" processRef="Proc_App" />
    <bpmn:participant id="Pool_Backend" name="Servidor Backend (FastAPI / Python)" processRef="Proc_Backend" />
    <bpmn:participant id="Pool_Offline" name="Preparação de dados e treino (offline, scripts)" processRef="Proc_Offline" />
    <bpmn:messageFlow id="MF_calc_req" name="POST /calcular" sourceRef="App_EnviarCalc" targetRef="Api_Inicio" />
    <bpmn:messageFlow id="MF_calc_resp" name="kWh, R$ e avisos" sourceRef="Api_Fim" targetRef="App_ResultadoCalc" />
    <bpmn:messageFlow id="MF_class_req" name="POST /classificar" sourceRef="App_EnviarClass" targetRef="Ml_Inicio" />
    <bpmn:messageFlow id="MF_class_resp" name="perfil e plano" sourceRef="Eco_Fim" targetRef="App_Perfil" />
    <bpmn:textAnnotation id="Nota_Offline">
      <bpmn:text>Roda uma vez pelos scripts (não a cada requisição). Os .pkl são versionados; a imagem da API leva só o kmeans.pkl.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_Class">
      <bpmn:text>Não usa o banco e não grava nada. Entrada inválida (moradores &lt; 1, lista vazia, consumo zero) → 422.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_Eco">
      <bpmn:text>PLANEJADO: Eco-Coach ainda não implementado. O payback é calculado em Python; o LLM só explica.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>

  <!-- ===================== App Flutter ===================== -->
  <bpmn:process id="Proc_App" isExecutable="false">
    <bpmn:startEvent id="App_Inicio" name="Usuário inicia simulação" />
    <bpmn:userTask id="App_Buscar" name="Buscar aparelho (marca/modelo)" />
    <bpmn:userTask id="App_Uso" name="Informar uso (horas, ciclos ou velocidade)" />
    <bpmn:userTask id="App_Dist" name="Escolher distribuidora ou digitar tarifa da conta" />
    <bpmn:sendTask id="App_EnviarCalc" name="Enviar POST /calcular" />
    <bpmn:intermediateCatchEvent id="App_ResultadoCalc" name="Resultado do cálculo recebido">
      <bpmn:messageEventDefinition id="MED_App_ResultadoCalc" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="App_Mais" name="Mais aparelhos?" />
    <bpmn:sendTask id="App_EnviarClass" name="Enviar POST /classificar (moradores + kWh de cada item)" />
    <bpmn:intermediateCatchEvent id="App_Perfil" name="Perfil recebido">
      <bpmn:messageEventDefinition id="MED_App_Perfil" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="App_Exibir" name="Exibir dashboard (custo, perfil e plano)" />
    <bpmn:endEvent id="App_Fim" name="Simulação concluída" />

    <bpmn:sequenceFlow id="F_a1" sourceRef="App_Inicio" targetRef="App_Buscar" />
    <bpmn:sequenceFlow id="F_a2" sourceRef="App_Buscar" targetRef="App_Uso" />
    <bpmn:sequenceFlow id="F_a3" sourceRef="App_Uso" targetRef="App_Dist" />
    <bpmn:sequenceFlow id="F_a4" sourceRef="App_Dist" targetRef="App_EnviarCalc" />
    <bpmn:sequenceFlow id="F_a5" sourceRef="App_EnviarCalc" targetRef="App_ResultadoCalc" />
    <bpmn:sequenceFlow id="F_a6" sourceRef="App_ResultadoCalc" targetRef="App_Mais" />
    <bpmn:sequenceFlow id="F_a7" name="Sim" sourceRef="App_Mais" targetRef="App_Buscar" />
    <bpmn:sequenceFlow id="F_a8" name="Não" sourceRef="App_Mais" targetRef="App_EnviarClass" />
    <bpmn:sequenceFlow id="F_a9" sourceRef="App_EnviarClass" targetRef="App_Perfil" />
    <bpmn:sequenceFlow id="F_a10" sourceRef="App_Perfil" targetRef="App_Exibir" />
    <bpmn:sequenceFlow id="F_a11" sourceRef="App_Exibir" targetRef="App_Fim" />
  </bpmn:process>

  <!-- ===================== Backend ===================== -->
  <bpmn:process id="Proc_Backend" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Backend">
      <bpmn:lane id="Lane_Api" name="API REST + PostgreSQL">
        <bpmn:flowNodeRef>Api_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Erro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Api_Fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ml" name="Machine Learning (K-Means)">
        <bpmn:flowNodeRef>Ml_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ml_Classificar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Eco" name="Agente Eco-Coach (planejado)">
        <bpmn:flowNodeRef>Eco_Payback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Rag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Llm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eco_Fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- POST /calcular -->
    <bpmn:startEvent id="Api_Inicio" name="POST /calcular recebido">
      <bpmn:messageEventDefinition id="MED_Api_Inicio" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Api_Validar" name="Validar aparelho, uso e tarifa" />
    <bpmn:exclusiveGateway id="Api_Valido" name="Dados válidos?" />
    <bpmn:endEvent id="Api_Erro" name="Erro 404 / 422 devolvido" />
    <bpmn:serviceTask id="Api_Calcular" name="Calcular kWh e R$ (regras Inmetro + tarifa ANEEL)" />
    <bpmn:serviceTask id="Api_Registrar" name="Registrar consulta (sem dados pessoais)">
      <bpmn:dataOutputAssociation id="DOA_Registrar">
        <bpmn:targetRef>DS_Postgres</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Api_Fim" name="Resultado enviado">
      <bpmn:messageEventDefinition id="MED_Api_Fim" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_Postgres" name="PostgreSQL (tabela consultas)" />

    <!-- POST /classificar -->
    <bpmn:startEvent id="Ml_Inicio" name="POST /classificar recebido">
      <bpmn:messageEventDefinition id="MED_Ml_Inicio" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Ml_Classificar" name="Classificar perfil (Consciente / Moderado / Ineficiente)">
      <bpmn:property id="Prop_Classificar" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Classificar">
        <bpmn:sourceRef>DOR_Kmeans</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Classificar</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObject id="DO_Kmeans" />
    <bpmn:dataObjectReference id="DOR_Kmeans" name="models/kmeans.pkl" dataObjectRef="DO_Kmeans" />

    <bpmn:serviceTask id="Eco_Payback" name="Calcular payback das trocas (Python)" />
    <bpmn:serviceTask id="Eco_Rag" name="Buscar diretrizes técnicas (RAG)">
      <bpmn:property id="Prop_Rag" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Rag">
        <bpmn:sourceRef>DS_Vetorial</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Rag</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Eco_Llm" name="Explicar plano de ação (LLM)" />
    <bpmn:endEvent id="Eco_Fim" name="Perfil e plano enviados">
      <bpmn:messageEventDefinition id="MED_Eco_Fim" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_Vetorial" name="Base vetorial (pgvector, candidato)" />

    <bpmn:sequenceFlow id="F_b1" sourceRef="Api_Inicio" targetRef="Api_Validar" />
    <bpmn:sequenceFlow id="F_b2" sourceRef="Api_Validar" targetRef="Api_Valido" />
    <bpmn:sequenceFlow id="F_b3" name="Sim" sourceRef="Api_Valido" targetRef="Api_Calcular" />
    <bpmn:sequenceFlow id="F_b4" name="Não" sourceRef="Api_Valido" targetRef="Api_Erro" />
    <bpmn:sequenceFlow id="F_b5" sourceRef="Api_Calcular" targetRef="Api_Registrar" />
    <bpmn:sequenceFlow id="F_b6" sourceRef="Api_Registrar" targetRef="Api_Fim" />
    <bpmn:sequenceFlow id="F_b7" sourceRef="Ml_Inicio" targetRef="Ml_Classificar" />
    <bpmn:sequenceFlow id="F_b8" sourceRef="Ml_Classificar" targetRef="Eco_Payback" />
    <bpmn:sequenceFlow id="F_b9" sourceRef="Eco_Payback" targetRef="Eco_Rag" />
    <bpmn:sequenceFlow id="F_b10" sourceRef="Eco_Rag" targetRef="Eco_Llm" />
    <bpmn:sequenceFlow id="F_b11" sourceRef="Eco_Llm" targetRef="Eco_Fim" />
  </bpmn:process>

  <!-- ===================== Offline ===================== -->
  <bpmn:process id="Proc_Offline" isExecutable="false">
    <bpmn:startEvent id="Off_Inicio" name="Novos dados Inmetro / ANEEL" />
    <bpmn:serviceTask id="Off_Limpar" name="Limpar datasets (tratar_dados_*.py)" />
    <bpmn:serviceTask id="Off_Carregar" name="Carregar no PostgreSQL (criar_banco.py)" />
    <bpmn:serviceTask id="Off_Seed" name="Gerar seed de residências por regras" />
    <bpmn:serviceTask id="Off_Ctgan" name="Treinar CTGAN e gerar residências sintéticas" />
    <bpmn:serviceTask id="Off_Kmeans" name="Treinar K-Means (gera kmeans.pkl)" />
    <bpmn:endEvent id="Off_Fim" name="Dados e modelos atualizados" />
    <bpmn:sequenceFlow id="F_c1" sourceRef="Off_Inicio" targetRef="Off_Limpar" />
    <bpmn:sequenceFlow id="F_c2" sourceRef="Off_Limpar" targetRef="Off_Carregar" />
    <bpmn:sequenceFlow id="F_c3" sourceRef="Off_Carregar" targetRef="Off_Seed" />
    <bpmn:sequenceFlow id="F_c4" sourceRef="Off_Seed" targetRef="Off_Ctgan" />
    <bpmn:sequenceFlow id="F_c5" sourceRef="Off_Ctgan" targetRef="Off_Kmeans" />
    <bpmn:sequenceFlow id="F_c6" sourceRef="Off_Kmeans" targetRef="Off_Fim" />
  </bpmn:process>

  <!-- ===================== Layout ===================== -->
  <bpmndi:BPMNDiagram id="Diagrama_iamp">
    <bpmndi:BPMNPlane id="Plano_iamp" bpmnElement="Colab_iamp">
      <!-- pools e lanes -->
      <bpmndi:BPMNShape id="S_Pool_App" bpmnElement="Pool_App" isHorizontal="true"><dc:Bounds x="0" y="0" width="2420" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Pool_Backend" bpmnElement="Pool_Backend" isHorizontal="true"><dc:Bounds x="0" y="320" width="2420" height="680" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Api" bpmnElement="Lane_Api" isHorizontal="true"><dc:Bounds x="30" y="320" width="2390" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Ml" bpmnElement="Lane_Ml" isHorizontal="true"><dc:Bounds x="30" y="560" width="2390" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Eco" bpmnElement="Lane_Eco" isHorizontal="true"><dc:Bounds x="30" y="760" width="2390" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Pool_Offline" bpmnElement="Pool_Offline" isHorizontal="true"><dc:Bounds x="0" y="1060" width="2420" height="220" /></bpmndi:BPMNShape>

      <!-- App -->
      <bpmndi:BPMNShape id="S_App_Inicio" bpmnElement="App_Inicio"><dc:Bounds x="80" y="112" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_Buscar" bpmnElement="App_Buscar"><dc:Bounds x="160" y="90" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_Uso" bpmnElement="App_Uso"><dc:Bounds x="320" y="90" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_Dist" bpmnElement="App_Dist"><dc:Bounds x="480" y="90" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_EnviarCalc" bpmnElement="App_EnviarCalc"><dc:Bounds x="640" y="90" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_ResultadoCalc" bpmnElement="App_ResultadoCalc"><dc:Bounds x="1330" y="112" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_Mais" bpmnElement="App_Mais" isMarkerVisible="true"><dc:Bounds x="1410" y="105" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_EnviarClass" bpmnElement="App_EnviarClass"><dc:Bounds x="1500" y="90" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_Perfil" bpmnElement="App_Perfil"><dc:Bounds x="2100" y="112" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_Exibir" bpmnElement="App_Exibir"><dc:Bounds x="2170" y="90" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_App_Fim" bpmnElement="App_Fim"><dc:Bounds x="2330" y="112" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_a1" bpmnElement="F_a1"><di:waypoint x="116" y="130" /><di:waypoint x="160" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a2" bpmnElement="F_a2"><di:waypoint x="280" y="130" /><di:waypoint x="320" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a3" bpmnElement="F_a3"><di:waypoint x="440" y="130" /><di:waypoint x="480" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a4" bpmnElement="F_a4"><di:waypoint x="600" y="130" /><di:waypoint x="640" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a5" bpmnElement="F_a5"><di:waypoint x="760" y="130" /><di:waypoint x="1330" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a6" bpmnElement="F_a6"><di:waypoint x="1366" y="130" /><di:waypoint x="1410" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a7" bpmnElement="F_a7"><di:waypoint x="1435" y="105" /><di:waypoint x="1435" y="40" /><di:waypoint x="220" y="40" /><di:waypoint x="220" y="90" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a8" bpmnElement="F_a8"><di:waypoint x="1460" y="130" /><di:waypoint x="1500" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a9" bpmnElement="F_a9"><di:waypoint x="1620" y="130" /><di:waypoint x="2100" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a10" bpmnElement="F_a10"><di:waypoint x="2136" y="130" /><di:waypoint x="2170" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_a11" bpmnElement="F_a11"><di:waypoint x="2290" y="130" /><di:waypoint x="2330" y="130" /></bpmndi:BPMNEdge>

      <!-- API -->
      <bpmndi:BPMNShape id="S_Api_Inicio" bpmnElement="Api_Inicio"><dc:Bounds x="682" y="422" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Api_Validar" bpmnElement="Api_Validar"><dc:Bounds x="760" y="400" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Api_Valido" bpmnElement="Api_Valido" isMarkerVisible="true"><dc:Bounds x="920" y="415" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Api_Erro" bpmnElement="Api_Erro"><dc:Bounds x="927" y="500" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Api_Calcular" bpmnElement="Api_Calcular"><dc:Bounds x="1010" y="400" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Api_Registrar" bpmnElement="Api_Registrar"><dc:Bounds x="1170" y="400" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_DS_Postgres" bpmnElement="DS_Postgres"><dc:Bounds x="1205" y="490" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Api_Fim" bpmnElement="Api_Fim"><dc:Bounds x="1330" y="422" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_b1" bpmnElement="F_b1"><di:waypoint x="718" y="440" /><di:waypoint x="760" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_b2" bpmnElement="F_b2"><di:waypoint x="880" y="440" /><di:waypoint x="920" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_b3" bpmnElement="F_b3"><di:waypoint x="970" y="440" /><di:waypoint x="1010" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_b4" bpmnElement="F_b4"><di:waypoint x="945" y="465" /><di:waypoint x="945" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_b5" bpmnElement="F_b5"><di:waypoint x="1130" y="440" /><di:waypoint x="1170" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_b6" bpmnElement="F_b6"><di:waypoint x="1290" y="440" /><di:waypoint x="1330" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_DOA_Registrar" bpmnElement="DOA_Registrar"><di:waypoint x="1230" y="480" /><di:waypoint x="1230" y="490" /></bpmndi:BPMNEdge>

      <!-- ML -->
      <bpmndi:BPMNShape id="S_Ml_Inicio" bpmnElement="Ml_Inicio"><dc:Bounds x="1542" y="642" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Ml_Classificar" bpmnElement="Ml_Classificar"><dc:Bounds x="1620" y="620" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_DOR_Kmeans" bpmnElement="DOR_Kmeans"><dc:Bounds x="1800" y="615" width="36" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Nota_Class" bpmnElement="Nota_Class"><dc:Bounds x="1220" y="610" width="280" height="70" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_b7" bpmnElement="F_b7"><di:waypoint x="1578" y="660" /><di:waypoint x="1620" y="660" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_b8" bpmnElement="F_b8"><di:waypoint x="1680" y="700" /><di:waypoint x="1680" y="840" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_DIA_Classificar" bpmnElement="DIA_Classificar"><di:waypoint x="1800" y="645" /><di:waypoint x="1740" y="650" /></bpmndi:BPMNEdge>

      <!-- Eco-Coach -->
      <bpmndi:BPMNShape id="S_Eco_Payback" bpmnElement="Eco_Payback"><dc:Bounds x="1620" y="840" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Eco_Rag" bpmnElement="Eco_Rag"><dc:Bounds x="1780" y="840" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_DS_Vetorial" bpmnElement="DS_Vetorial"><dc:Bounds x="1815" y="775" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Eco_Llm" bpmnElement="Eco_Llm"><dc:Bounds x="1940" y="840" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Eco_Fim" bpmnElement="Eco_Fim"><dc:Bounds x="2100" y="862" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Nota_Eco" bpmnElement="Nota_Eco"><dc:Bounds x="1220" y="840" width="300" height="70" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_b9" bpmnElement="F_b9"><di:waypoint x="1740" y="880" /><di:waypoint x="1780" y="880" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_b10" bpmnElement="F_b10"><di:waypoint x="1900" y="880" /><di:waypoint x="1940" y="880" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_b11" bpmnElement="F_b11"><di:waypoint x="2060" y="880" /><di:waypoint x="2100" y="880" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_DIA_Rag" bpmnElement="DIA_Rag"><di:waypoint x="1840" y="825" /><di:waypoint x="1840" y="840" /></bpmndi:BPMNEdge>

      <!-- Offline -->
      <bpmndi:BPMNShape id="S_Off_Inicio" bpmnElement="Off_Inicio"><dc:Bounds x="80" y="1152" width="36" height="36" /></bpmndi:BPMNShape>

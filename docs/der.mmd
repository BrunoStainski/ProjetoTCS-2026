%% DER do banco do iamp (PostgreSQL 15 + pgvector). Fonte: src/banco.py (SCHEMA) e src/rag.py (RAG_SCHEMA).
%% Linha cheia = chave estrangeira no banco. Linha tracejada = ligação lógica (mesmo valor, sem FK).
%% Gerar a imagem: npx -p @mermaid-js/mermaid-cli mmdc -i docs/der.mmd -o docs/der.png -b white -s 2
erDiagram
    distribuidoras ||--o{ tarifas : "tem (FK distribuidora_id)"
    distribuidoras ||..o| vw_tarifa_vigente : "view: tarifa válida hoje"
    tarifas ||..o| vw_tarifa_vigente : "vigência mais recente"
    aparelhos ||..o{ consultas : "copia categoria, marca, modelo"
    distribuidoras ||..o{ consultas : "copia nome e UF"
    cargas ||..o{ aparelhos : "arquivo_origem"
    usuarios ||--o{ sessoes : "tem (FK usuario_id, cascata)"
    usuarios ||--o{ casas : "tem (FK usuario_id, cascata)"
    casas ||--o{ itens_casa : "tem (FK casa_id, cascata)"

    aparelhos {
        bigint id PK "fixo: hash do nome"
        text categoria "UK com marca, modelo e tensao"
        text marca
        text modelo
        text tipo
        float capacidade "L, pol, BTU/h, W, kg ou cv"
        text unidade
        text detalhe
        text tensao "127/220 só se o consumo muda; vazio = vale para as duas"
        float kwh_mes
        float kwh_mes_baixa "ventilador"
        float kwh_mes_media "ventilador"
        float kwh_mes_alta "ventilador"
        float kwh_ciclo "máquina de lavar"
        float potencia_w
        float standby_kwh_mes
        float fluxo_lm "lâmpadas"
        text origem_dado
        text arquivo_origem
        text busca
    }

    distribuidoras {
        serial id PK
        text nome UK
        char2 uf
        text fonte_uf
    }

    tarifas {
        serial id PK
        int distribuidora_id FK
        text classe "residencial_b1"
        float tarifa_kwh "TUSD + TE"
        date vigencia_inicio
        text fonte
    }

    vw_tarifa_vigente {
        int distribuidora_id
        text distribuidora
        char2 uf
        float tarifa_kwh
        date vigencia_inicio
        text fonte
    }

    cargas {
        serial id PK
        text arquivo
        int linhas
        timestamp carregado_em
    }

    consultas {
        serial id PK
        timestamp criado_em
        text categoria
        text marca
        text modelo
        text uf
        text distribuidora
        float horas_dia
        float ciclos_mes
        text velocidade
        float kwh_mes
        text metodo
        float tarifa_kwh
        text origem_tarifa "ANEEL ou manual"
        float custo_mes
        float dias_mes "ar-condicionado"
        text detalhe "separa 127 V e 220 V"
    }

    portateis {
        text categoria PK
        text nome
        float potencia_w
        float horas_dia
        float dias_mes
        text fonte
    }




    usuarios {
        serial id PK
        text nome
        text email UK "minúsculas"
        text senha_hash "scrypt com sal, nunca a senha"
        timestamptz consentimento_em "aceite do aviso"
        text versao_aviso
        timestamptz criado_em
    }

    sessoes {
        text token_hash PK "SHA-256 do token"
        int usuario_id FK
        timestamptz criada_em
        timestamptz expira_em "30 dias"
    }

    casas {
        serial id PK
        int usuario_id FK
        text nome
        int moradores
        jsonb ultima_tarifa
        timestamptz criado_em
        timestamptz atualizado_em
    }

    itens_casa {
        serial id PK
        int casa_id FK "UK com posicao"
        int posicao
        int quantidade
        text categoria
        float kwh_mes "de 1 unidade"
        float custo_mes
        jsonb dados "pergunta + resultado (formato do app)"
    }

    trechos_rag {
        serial id PK
        text documento
        text orgao
        text tipo_fonte
        text url
        text arquivo
        text secao
        int pagina
        text texto
        vector768 embedding "pgvector, gemini-embedding-001"
        timestamp carregado_em
    }
